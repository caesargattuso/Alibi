# App
APP_NAME=AI互动游戏平台
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_game

# Redis
REDIS_URL=redis://redis:6379/0

# AI - SiliconFlow (OpenAI compatible)
SILICONFLOW_API_KEY=your-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Pro
AI_MAX_TOKENS=4096
AI_TIMEOUT=60
AI_MAX_RETRIES=3
AI_MAX_CONCURRENCY=10

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Rate Limit
RATE_LIMIT_API=100/minute
RATE_LIMIT_AI=30/minute

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
